{
  "name": "@eter/design-system",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "ETER Healthcare Technology Platform — Design System",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens": {
      "types": "./src/design-tokens.ts",
      "import": "./src/design-tokens.ts",
      "default": "./src/design-tokens.ts"
    },
    "./theme.css": "./src/styles/theme.css",
    "./tailwind.preset": "./tailwind.config.js",
    "./assets/logos/*": "./src/assets/logos/*"
  },
  "files": [
    "src/",
    "tailwind.config.js",
    "README.md",
    "CHANGELOG.md",
    "MIGRATION.md",
    ".design-sync/",
    "design-sync.skill"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ETER-HEALTH/eter-design-system.git"
  },
  "homepage": "https://github.com/ETER-HEALTH/eter-design-system#readme",
  "bugs": {
    "url": "https://github.com/ETER-HEALTH/eter-design-system/issues"
  },
  "keywords": [
    "eter",
    "design-system",
    "healthcare",
    "react",
    "typescript",
    "tailwind"
  ],
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "type-check": "tsc --noEmit"
  },
  "license": "UNLICENSED"
}
